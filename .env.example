# 复制本文件为 .env，并填入你的 MiniMax API Key
# 国内用户：platform.minimaxi.com -> 账户管理/接口密钥 -> 创建 API Key
# 国际用户：platform.minimax.io，并把 BASE_URL 改为 https://api.minimax.io/v1
MINIMAX_API_KEY=sk-xxxxxxxxxxxxxxxx
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_TEXT_MODEL=MiniMax-M2
MINIMAX_VISION_MODEL=MiniMax-M3
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_URL=https://api.minimaxi.com/v1/t2a_v2
# 可选：MiniMax 的 Anthropic 兼容接口（MiniMax-M3 文本/图片），一般无需修改
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# auto=有 Key 时走真实 API，无 Key 时自动演示；填 1 强制演示，填 0 强制真实调用
DEMO_MODE=auto

# 是否启用真实视觉/OCR/ASR：0=模拟，1=启用真实模型
USE_PADDLEDETECTION=0
USE_PADDLEOCR=0
USE_ASR=0
